views:
  - type: cards
    name: Books
    filters:
      and:
        - file.inFolder("02 - Areas/Books")
    image: note.cover
    imageAspectRatio: 1
    cardSize: 160
  - type: cards
    name: View
    filters:
      and:
        - file.inFolder("02 - Areas/Books")
        - file.hasProperty("status")
    image: note.cover
